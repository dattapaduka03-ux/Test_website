                    {service}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h4 className="font-bold mb-4">About</h4>
            <ul className="space-y-2 text-sm">
              {["History", "Ashram", "Trust Info", "Guru Lineage"].map((item) => (
                <li key={item}>
                  <a href="#" className="hover:text-accent transition-colors">
                    {item}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h4 className="font-bold mb-4">Newsletter</h4>
            <p className="text-sm mb-4">Subscribe to our newsletter for updates and spiritual insights.</p>
            <input
              type="email"
              placeholder="Your email"
              className="w-full px-3 py-2 rounded text-foreground text-sm mb-2"
            />
            <Button className="w-full bg-white text-primary hover:shadow-lg text-sm font-bold border-2 border-white">Subscribe</Button>
          </div>
        </div>

        <div className="border-t border-white/20 pt-6 sm:pt-8 text-center text-xs sm:text-sm">
          <p>&copy; 2015-2026 AVIMUKTHA DATTA PAADUKA. All Rights Reserved.</p>
          <p className="mt-2">Sadguru Sree Sree Sree Ramananda Swamy Ashrama Vishwasta Samithi (R)</p>
        </div>
      </div>
    </footer>
  );

  // Render current page
  const renderPage = () => {
    switch (currentPage) {
      case "guru":
        return <GuruPage />;
      case "sevas":
        return <SevasPage />;
      case "activities":
        return <ActivitiesPage />;
      case "gallery":
        return <GalleryPage />;
      case "trust":
        return <TrustPage />;
      case "sthala":
        return <SthalaPage />;
      case "contact":
        return <ContactPage />;
      default:
        return <HomePage />;
    }
  };

  return (
    <div className="min-h-screen flex flex-col bg-background">
      <Header />
      <main className="flex-1">{renderPage()}</main>
      <Footer />

      {/* Donate Modal */}
      {showDonateForm && (
        <div className="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
          <Card className="w-full max-w-md p-6 sm:p-8 bg-white">
            <h2 className="text-xl sm:text-2xl font-bold text-primary mb-6">Make a Donation</h2>
            <p className="text-sm sm:text-base text-foreground mb-6">
              Your generous donation helps us preserve our spiritual heritage and serve the community.
            </p>
            <div className="space-y-4 mb-6">
              {[100, 500, 1000, 5000].map((amount) => (
                <Button
                  key={amount}
                  className="w-full gradient-primary text-white hover:shadow-lg shine-effect font-bold"
                >
                  ₹{amount}
                </Button>
              ))}
            </div>
            <Button
              className="w-full gradient-primary text-white hover:shadow-lg shine-effect font-bold mb-4"
            >
              Custom Amount
            </Button>
            <Button variant="outline" className="w-full border-primary text-primary hover:bg-primary/10" onClick={() => setShowDonateForm(false)}>
              Close
            </Button>
          </Card>
        </div>
      )}
