            {/* Contact Form */}
            <Card className="p-6 sm:p-8 bg-white">
              <h3 className="text-xl sm:text-2xl font-bold text-primary mb-6">Send Us A Message</h3>
              <form className="space-y-3 sm:space-y-4">
                <div>
                  <label className="block text-xs sm:text-sm font-medium text-foreground mb-2">Name</label>
                  <input
                    type="text"
