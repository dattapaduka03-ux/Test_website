            className="bg-white text-primary hover:shadow-lg font-bold shine-effect"
            onClick={() => setShowDonateForm(!showDonateForm)}
          >
            <Heart className="w-5 h-5 mr-2" />
            DONATE NOW
          </Button>
        </div>
      </section>
    </>
  );

  // Guru Parampara Page
  const GuruPage = () => (
    <div className="min-h-screen bg-background">
      {/* Hero Section */}
      <section
        className="relative h-48 sm:h-64 md:h-80 flex items-center justify-center text-center overflow-hidden"
        style={{
          backgroundImage: `url('${heroImages.guru}')`,
          backgroundSize: "cover",
          backgroundPosition: "center",
        }}
      >
        <div className="absolute inset-0 bg-black/40"></div>
        <div className="relative z-10 px-4 text-center">
          <h1 className="text-3xl sm:text-4xl md:text-6xl font-bold text-white">Guru Parampara</h1>
          <div className="w-24 h-1 bg-accent mx-auto mt-4"></div>
        </div>
      </section>

      <div className="py-20">
        <div className="container mx-auto px-4">
          <div className="max-w-4xl mx-auto mb-12">
            <p className="text-lg text-foreground leading-relaxed mb-8">
              Pranava Peetam, the Sanathana Sadguru Peetam was started by Adiguru Sri Sri Sri Dathathreya Prabhu and till now came across 18 Sadgurus in this Guru Parampara Lineage.
            </p>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 max-w-4xl mx-auto">
            {(getTranslatedArray("guru.list")).map((guru, idx) => (
              <Card key={idx} className="p-6 bg-white border-l-4 border-primary hover:shadow-lg transition-shadow">
                <div className="flex items-start gap-4">
                  <div className="text-2xl font-bold text-primary">ॐ</div>
                  <p className="text-lg font-semibold text-foreground">{guru}</p>
                </div>
              </Card>
            ))}
          </div>
        </div>
      </div>
    </div>
  );

  // Sevas Page
  const SevasPage = () => (
    <div className="min-h-screen bg-background">
      {/* Hero Section */}
      <section
        className="relative h-48 sm:h-64 md:h-80 flex items-center justify-center text-center overflow-hidden"
        style={{
          backgroundImage: `url('${heroImages.sevas}')`,
          backgroundSize: "cover",
          backgroundPosition: "center",
        }}
      >
        <div className="absolute inset-0 bg-black/40"></div>
        <div className="relative z-10 px-4">
          <h1 className="text-3xl sm:text-4xl md:text-6xl font-bold text-white">{t('sevas.title')}</h1>
          <div className="w-24 h-1 bg-accent mx-auto mt-4"></div>
        </div>
      </section>

      <div className="py-20">
        <div className="container mx-auto px-4">
          <p className="text-lg text-center text-foreground mb-12 max-w-2xl mx-auto">
            {t('sevas.content')}
          </p>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 max-w-5xl mx-auto">
            {(getTranslatedArray("sevas.list")).map((seva, idx) => (
              <Card key={idx} className="p-6 bg-white border-t-4 border-primary hover:shadow-lg transition-shadow">
                <div className="flex items-start gap-3">
                  <span className="text-primary font-bold text-xl">✦</span>
                  <p className="text-lg font-semibold text-foreground">{seva}</p>
                </div>
              </Card>
            ))}
          </div>
        </div>
      </div>
    </div>
  );

  // Gallery Page
  const GalleryPage = () => (
    <div className="min-h-screen bg-background">
      {/* Hero Section */}
      <section className="relative h-48 sm:h-64 md:h-80 flex items-center justify-center text-center overflow-hidden bg-gradient-to-r from-primary/20 to-accent/20">
        <div className="relative z-10 px-4">
          <h1 className="text-3xl sm:text-4xl md:text-6xl font-bold text-primary mb-4">{t('gallery.title')}</h1>
          <div className="w-24 h-1 bg-accent mx-auto"></div>
        </div>
      </section>

      {/* Gallery Grid */}
      <div className="py-20">
        <div className="container mx-auto px-4">
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 max-w-7xl mx-auto">
            {galleryImages.map((image, idx) => (
              <div
                key={idx}
                onClick={() => setSelectedGalleryImage(image)}
                className="group relative overflow-hidden rounded-lg cursor-pointer h-48 sm:h-64 shadow-md hover:shadow-xl transition-all duration-300"
              >
                <img
                  src={image}
                  alt={`Gallery ${idx + 1}`}
                  className="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                  onError={(e) => {
                    e.currentTarget.src = "https://via.placeholder.com/400x300?text=Gallery+Image";
                  }}
                />
                <div className="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-all duration-300 flex items-center justify-center">
                  <div className="text-white text-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <p className="font-semibold text-lg">View</p>
                  </div>
                </div>
                <div className="absolute inset-0 border-4 border-primary opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-lg"></div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Lightbox */}
      {selectedGalleryImage && (
        <div className="fixed inset-0 z-50 bg-black/90 flex items-center justify-center p-4">
          <div className="relative w-full max-w-4xl">
            <button
              onClick={() => setSelectedGalleryImage(null)}
              className="absolute -top-12 right-0 text-white hover:text-accent transition-colors text-2xl"
            >
              ✕
            </button>
            <img
              src={selectedGalleryImage}
              alt="Gallery Full View"
              className="w-full h-auto max-h-[60vh] sm:max-h-[70vh] object-contain rounded-lg"
            />
          </div>
        </div>
      )}
    </div>
  );

  // Activities Page
  const ActivitiesPage = () => (
    <div className="min-h-screen bg-background">
      {/* Hero Section */}
      <section
        className="relative h-48 sm:h-64 md:h-80 flex items-center justify-center text-center overflow-hidden"
        style={{
          backgroundImage: `url('${heroImages.activities}')`,
          backgroundSize: "cover",
          backgroundPosition: "center",
        }}
      >
        <div className="absolute inset-0 bg-black/40"></div>
        <div className="relative z-10 px-4">
          <h1 className="text-3xl sm:text-4xl md:text-6xl font-bold text-white">{t('activities.title')}</h1>
          <div className="w-24 h-1 bg-accent mx-auto mt-4"></div>
        </div>
      </section>

      <div className="py-20">
        <div className="container mx-auto px-4">
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8 max-w-5xl mx-auto">
            {[
              {
                title: "ANNADHAANAM",
                description:
                  "Daily food is provided freely to the visitors. On the Day of Purnima, every month after Guru Puja thousands of devotees will have food as Anna Prasadam at our Ashram.",
              },
              {
                title: "VIDHYADHAANAM",
                description:
                  "Every year text books, note books, school bags and other student stationaries are distributed to the poor and eligible students. Scholarships are also provided to the deserved hard working students.",
              },
              {
                title: "VASTRADHAANAM",
                description:
                  "Clothes and bedsheets are distributed to the poor and needy during special occasions like Guru Aaradhana and Jayanthotsavam.",
              },
              {
                title: "AROGYADHAANAM",
                description:
                  "Free and special medical camps are conducted regularly at our Ashram, which can be availed by anyone in the society. Free medicines are also provided to the deserved poor patients.",
              },
              {
                title: "GNANADHAANAM",
                description:
                  "Books related to spirituality, history, traditions, human values, ethics, puranas, meditation, ayurveda, yoga and other Sanathana literatures are published and distributed freely.",
              },
              {
                title: "PRAKRUTHI VANDANAM",
                description:
                  "Campaigns and workshops are conducted regarding environmental pollutions, rain water harvesting, importance of forests, plantation of trees, and preserving endangered species.",
              },
              {
                title: "KAALAGNAANAM",
                description: "New year calendars containing Panchangam are distributed freely to the devotees every year.",
              },
              {
                title: "GOURAVA PRADHAANAM",
                description:
                  "Facilitations have been done and awards have been given to the achievers in different fields during special occasions.",
              },
            ].map((activity, idx) => (
              <Card key={idx} className="p-6 sm:p-8 bg-white hover:shadow-lg transition-shadow">
                <h3 className="text-xl sm:text-2xl font-bold text-primary mb-4">{activity.title}</h3>
                <p className="text-sm sm:text-base text-foreground leading-relaxed">{activity.description}</p>
              </Card>
            ))}
          </div>
        </div>
      </div>
    </div>
  );

  // Trust Page
  const TrustPage = () => (
    <div className="min-h-screen bg-background">
      {/* Hero Section */}
      <section
        className="relative h-48 sm:h-64 md:h-80 flex items-center justify-center text-center overflow-hidden"
        style={{
          backgroundImage: `url('${heroImages.trust}')`,
          backgroundSize: "cover",
          backgroundPosition: "center",
        }}
      >
        <div className="absolute inset-0 bg-black/40"></div>
        <div className="relative z-10 px-4">
          <h1 className="text-3xl sm:text-4xl md:text-6xl font-bold text-white">{t('trust.title')}</h1>
          <div className="w-24 h-1 bg-accent mx-auto mt-4"></div>
        </div>
      </section>

      <div className="py-20">
        <div className="container mx-auto px-4">
          <div className="max-w-3xl mx-auto">
            <Card className="p-6 sm:p-12 bg-white mb-8">
              <h2 className="text-2xl sm:text-3xl font-bold text-primary mb-8">
                SADGURU SREE SREE SREE RAMANANDA SWAMY ASHRAMA VISHWASTA SAMITHI (R)
              </h2>

              <div className="space-y-4 sm:space-y-6 text-sm sm:text-base text-foreground leading-relaxed">
                <p>
                  Earlier on 26.06.1979, under the Presidentship of the 16th Sadguru of the Pranava Peetam, Sadguru Sri Sri Sri Raamaananda Swamy the trust called Srimad Dathathreya Ashrama was founded, which was not registered legally until 1990.
                </p>

                <p>
                  On 07.02.1990, the trust was registered under the Presidentship of Sadguru Sri Sri Sri Raamaananda Swamy and other eight voluntary devotees. On the demise of the President of the trust and other members of the trust, as per the will of Sadguru Sri Sri Sri Raamaananda Swamy the remaining devotees unanimously resolved to wind up the said trust to reform a new trust called SADGURU SREE SREE SREE RAMANANDA SWAMY ASHRAMA VISHWASTA SAMITHI (R).
                </p>

                <p>
                  As a result, on 02.03.2015, a new Trust called Sadguru Sree Sree Sree Ramananda Swamy Ashrama Vishwasta Samithi (R) has been formed and registered under the Presidentship of the 18th Sadguru of Pranava Peeta Guru Parampara, Sadguru Sri Maathe Mukthaambkie Devi and other 15 Voluntary Devotees. The Trust is registered under 80G and 12AA acts of INCOME TAX DEPARTMENT of GOVERNMENT OF BHARATH.
                </p>

                <p>
                  This managing Trust maintains the Ashram and controls other activities of the Ashram. It conducts conventions and activities on philosophical, religious and spiritual subjects. It also extends helping hand to the needy by distributing books and scholarships to the students and medicines to the suffering poor patients.
                </p>
              </div>
            </Card>
          </div>
        </div>
      </div>
    </div>
  );

  // Sthala Puranam Page
  const SthalaPage = () => (
    <div className="min-h-screen bg-background">
      {/* Hero Section */}
      <section
        className="relative h-48 sm:h-64 md:h-80 flex items-center justify-center text-center overflow-hidden"
        style={{
          backgroundImage: `url('${heroImages.sthala}')`,
          backgroundSize: "cover",
          backgroundPosition: "center",
        }}
      >
        <div className="absolute inset-0 bg-black/40"></div>
        <div className="relative z-10 px-4">
          <h1 className="text-3xl sm:text-4xl md:text-6xl font-bold text-white">{t('sthala.title')}</h1>
          <div className="w-24 h-1 bg-accent mx-auto mt-4"></div>
        </div>
      </section>

      <div className="py-20">
        <div className="container mx-auto px-4">
          <div className="max-w-3xl mx-auto">
            <Card className="p-6 sm:p-12 bg-white">
              <div className="space-y-4 sm:space-y-6 text-sm sm:text-base text-foreground leading-relaxed">
                <p>
                  Avimuktha data Kshetram is the sacred place where daily worship is done to the 2000 years old Rathnagarbha, Navapaashanayuktha, Srichakraankitha Avimuktha Datta Lingam, in which Dattatreya Muthy is engraved in front of the shiva lingam attached to it. On top of this Lingam later Srichakram is encarved by Sri Adi Shankaraachaarya.
                </p>

                <p>
                  This is the Holy place where world's one and only one self luminous celestial Vrushabhaarooda Spatika Datta Atma Lingam is worshipped, which is an eternal gift blessed by Lord Guru Datta to the same NANDA MAHARAJA of Pandava clan.
                </p>

                <p>
                  This Holy place is called as AVIMUKTHA DATTA KSHETRAM, where the AVIMUKTHA DATTA PAADUKAS, the real PAADA MUDRAAS of Lord Dattatreya is worshipped daily.
                </p>

                <p>
                  This place is also called as DATTAAVADHOOTA KSHETRAM where ADIGURU SRI DATTATREYA SWAMY preached the AVADHOOTHA GEETHA to the GNANA SHAKTHI SWAMYNAATHA SRI SUBRAHMANYESHWARA in the form of AVADHOOTA.
                </p>

                <p>
                  It is also called as DHAATHRIVANA KSHETRAM, where Lord ADIGURU DATTATREYA appeared in Surya Mandala and preached SRI DATTA SAHASRANAAMAM to SRI ADI SHANKARAACHAARYA.
                </p>

                <p>
                  This is the most blessed holy place of Datta Parampara where Lord Guru Dattatreya granted the salvation to Nanda Maharaja of Pandava's clan. This is spiritually inclined SIDDHA KSHETRAM visited by NAVNAATH even today in the sookshma roopam. It is called as NAVAVATA KSHETRAM, due to nine divine trees representing NAVNAATH which are situated on the east bank of the river Dakshina Pinakini.
                </p>

                <p>
                  This is the divine Theertha Kshetram where 16th Sadguru of Pranava Peetam of Adiguru Dattatreya Parampara, Sadguru Sri Sri Sri RAAMAANADA SWAMY took Samadhi having live darshan of the Lord Guru Datta. Even today from his Samadhi Adhishtaana itself he is blessing the visiting devotees.
                </p>
              </div>
            </Card>
          </div>
        </div>
      </div>
    </div>
  );

  // Contact Page
  const ContactPage = () => (
