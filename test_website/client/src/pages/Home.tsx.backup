import { Button } from "@/components/ui/button";
import translations from "@/translations.json";
import { Card } from "@/components/ui/card";
import { Mail, Phone, MapPin, Facebook, Youtube, Send, MessageCircle, Heart, Menu, X, Globe } from "lucide-react";
import { useState } from "react";
import { useLanguage } from "@/contexts/LanguageContext";

/**
 * Vedic Minimalism Design System
 * - Primary: Deep Orange (#ff901c) to Golden Yellow (#ffc61d) - spiritual fire and transformation
 * - Accent: Gold (#D4AF37) - divinity and enlightenment
 * - Background: Cream (#F5E6D3) - meditative space
 * - Typography: Playfair Display (headings), Lora (body), Crimson Text (quotes)
 * - Spacing: Generous whitespace creating meditative pauses
 */

export default function Home() {
  const [currentPage, setCurrentPage] = useState("home");
  const [showDonateForm, setShowDonateForm] = useState(false);
  const [selectedGalleryImage, setSelectedGalleryImage] = useState<string | null>(null);
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [languageMenuOpen, setLanguageMenuOpen] = useState(false);
  const { language, setLanguage, t } = useLanguage();
  
  // Helper function to get translated arrays
  const getTranslatedArray = (path: string): string[] => {
    const keys = path.split('.');
    let current: any = translations[language];
    for (const key of keys) {
      if (current && typeof current === 'object' && key in current) {
        current = current[key];
      } else {
        return [];
      }
    }
    return Array.isArray(current) ? current : [];
  };

  // Navigation handler
  const navigate = (page: string) => {
    setCurrentPage(page);
    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  // Page-specific hero images
  const heroImages: Record<string, string> = {
    guru: "/images/hero-guru.jpg",
    sevas: "/images/hero-sevas.jpg",
    activities: "/images/hero-activities.jpg",
    trust: "/images/hero-trust.jpg",
    sthala: "/images/hero-sthala.jpg",
    contact: "/images/hero-contact.jpg",
  };

  // Gallery images
  const galleryImages = [
    "/images/hero-guru.jpg",
    "/images/hero-sevas.jpg",
    "/images/hero-activities.jpg",
    "/images/hero-trust.jpg",
    "/images/hero-sthala.jpg",
    "/images/hero-contact.jpg",
    "/images/gallery-7.jpg",
    "/images/gallery-8.jpg",
  ];

  const navigationItems = [
    { id: "home", label: t('nav.home') },
    { id: "guru", label: t('nav.guru') },
    { id: "sevas", label: t('nav.sevas') },
    { id: "activities", label: t('nav.activities') },
    { id: "gallery", label: t('nav.gallery') },
    { id: "trust", label: t('nav.trust') },
    { id: "sthala", label: t('nav.sthala') },
    { id: "contact", label: t('nav.contact') },
  ];

  // Header Navigation
  const Header = () => (
    <header className="sticky top-0 z-50 bg-white shadow-md">
      <div className="container mx-auto px-4 py-3">
        <div className="flex items-center justify-between">
          {/* Logo */}
          <div className="flex items-center gap-2 sm:gap-4 cursor-pointer" onClick={() => navigate("home")}>
            <img 
              src="https://d2xsxph8kpxj0f.cloudfront.net/310519663437777193/jviz57jALUmVLVWV8gxDYY/Screenshot2026-04-12at9.24.40AM_86196d0b.png" 
              alt="Avimuktha Datta Paaduka Logo" 
              className="w-12 sm:w-16 lg:w-20 h-12 sm:h-16 lg:h-20 object-contain"
            />
            <div>
              <h1 className="text-lg sm:text-xl font-bold text-primary">Avimuktha</h1>
              <p className="text-xs sm:text-sm text-muted-foreground">Datta Paaduka</p>
            </div>
          </div>

          {/* Navigation Menu - Desktop */}
          <nav className="hidden lg:flex gap-2 xl:gap-4">
            {navigationItems.map((item) => (
              <button
                key={item.id}
                onClick={() => navigate(item.id)}
                className={`text-sm font-medium transition-colors ${
                  currentPage === item.id
                    ? "text-primary border-b-2 border-primary"
                    : "text-foreground hover:text-primary"
                }`}
              >
                {item.label}
              </button>
            ))}
          </nav>

          {/* CTA Buttons & Hamburger */}
          <div className="flex items-center gap-3">
            {/* Language Switcher */}
            <div className="relative">
              <button
                onClick={() => setLanguageMenuOpen(!languageMenuOpen)}
                className="flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-primary hover:bg-gray-100 transition-colors"
              >
                <Globe className="w-5 h-5" />
                <span className="hidden sm:inline">{language.toUpperCase()}</span>
              </button>
              
              {languageMenuOpen && (
                <div className="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 z-50">
                  <button
                    onClick={() => { setLanguage('en'); setLanguageMenuOpen(false); }}
                    className={`w-full text-left px-4 py-2 hover:bg-gray-100 transition-colors ${language === 'en' ? 'bg-primary text-white' : ''}`}
                  >
                    English
                  </button>
                  <button
                    onClick={() => { setLanguage('hi'); setLanguageMenuOpen(false); }}
                    className={`w-full text-left px-4 py-2 hover:bg-gray-100 transition-colors ${language === 'hi' ? 'bg-primary text-white' : ''}`}
                  >
                    हिन्दी (Hindi)
                  </button>
                  <button
                    onClick={() => { setLanguage('kn'); setLanguageMenuOpen(false); }}
                    className={`w-full text-left px-4 py-2 hover:bg-gray-100 transition-colors ${language === 'kn' ? 'bg-primary text-white' : ''}`}
                  >
                    ಕನ್ನಡ (Kannada)
                  </button>
                  <button
                    onClick={() => { setLanguage('te'); setLanguageMenuOpen(false); }}
                    className={`w-full text-left px-4 py-2 hover:bg-gray-100 transition-colors ${language === 'te' ? 'bg-primary text-white' : ''}`}
                  >
                    తెలుగు (Telugu)
                  </button>
                </div>
              )}
            </div>
            
            {/* Hamburger Menu Button */}
            <button
              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
              className="lg:hidden p-2 hover:bg-gray-100 rounded-lg transition-colors"
              aria-label="Toggle menu"
            >
              {mobileMenuOpen ? (
                <X className="w-6 h-6 text-primary" />
              ) : (
                <Menu className="w-6 h-6 text-primary" />
              )}
            </button>
          </div>
        </div>

        {/* Mobile Navigation Menu */}
        {mobileMenuOpen && (
          <nav className="lg:hidden mt-4 pb-4 border-t border-gray-200">
            <div className="flex flex-col gap-2">
              {navigationItems.map((item) => (
                <button
                  key={item.id}
                  onClick={() => {
                    navigate(item.id);
                    setMobileMenuOpen(false);
                  }}
                  className={`text-left px-4 py-2 rounded-lg transition-colors ${
                    currentPage === item.id
                      ? "bg-primary text-white font-medium"
                      : "text-foreground hover:bg-gray-100"
                  }`}
                >
                  {item.label}
                </button>
              ))}

            </div>
          </nav>
        )}
      </div>
    </header>
  );

  // Home Page
  const HomePage = () => (
    <>
      {/* Hero Section */}
      <section
        className="relative min-h-screen sm:h-screen flex items-center justify-center text-center overflow-hidden"
        style={{
          backgroundImage: `url('https://d2xsxph8kpxj0f.cloudfront.net/310519663437777193/jviz57jALUmVLVWV8gxDYY/hero_gateway_flowers_final_dattatreya_9ce06c58.png')`,
          backgroundSize: "cover",
          backgroundPosition: "center",
        }}
      >
        <div className="absolute inset-0 bg-black/30"></div>
        <div className="relative z-10 max-w-2xl mx-auto px-4 py-12 sm:py-0">
          <p className="text-white text-sm sm:text-lg mb-4 font-light tracking-widest" style={{fontSize: '25px', fontWeight: '900', paddingTop: '50px'}}>Sri Avimuktha</p>
          <h1 className="text-3xl sm:text-5xl md:text-7xl text-white mb-6 font-bold leading-tight">DATTA KSHETRAM</h1>
          <div className="space-y-2 sm:space-y-3 text-white/90 mb-8 text-xs sm:text-base md:text-lg">
            <p>Srimad Adiguru Dattatreya Paramparanugatha Pranava Peeta Nirguna Maha Samsthanam</p>
            <p>Srimad Dattatreya Ashrama Prarthana Mandiram</p>
            <p>Sadguru Sree Sree Sree Ramananda Swamy Ashrama Vishwastha Samithi ®</p>
            <p>Historical Saptapuri Nagara or Navasaala Nagari – Hosakote</p>
          </div>
          <Button
            size="lg"
            className="bg-white text-primary hover:shadow-lg font-bold shine-effect"
            onClick={() => navigate("contact")}
          >
            CONTACT NOW
          </Button>
        </div>
      </section>

      {/* About Section */}
      <section className="py-12 sm:py-20 bg-background spiritual-section">
        <div className="container mx-auto px-4">
          <h2 className="text-2xl sm:text-3xl md:text-4xl font-bold text-center text-primary leading-tight mb-8">
            SADGURU SREE SREE SREE RAMANANDA SWAMY<br className="hidden sm:block" />ASHRAMA VISHWASTA SAMITHI (R)
          </h2>
          <div className="max-w-3xl mx-auto">
            <p className="text-base sm:text-lg text-foreground leading-relaxed mb-6">
              Earlier on 26.06.1979, under the Presidentship of the 16th Sadguru of the Pranava Peetam, Sadguru Sri Sri Sri Raamaananda Swamy the trust called Srimad Dathathreya Ashrama was founded, which was not registered legally until 1990.
            </p>
            <p className="text-base sm:text-lg text-foreground leading-relaxed mb-6">
              On 07.02.1990, the trust was registered under the Presidentship of Sadguru Sri Sri Sri Raamaananda Swamy and other eight voluntary devotees. On the demise of the President of the trust and other members of the trust, as per the will of Sadguru Sri Sri Sri Raamaananda Swamy the remaining devotees unanimously resolved to wind up the said trust to reform a new trust called SADGURU SREE SREE SREE RAMANANDA SWAMY ASHRAMA VISHWASTA SAMITHI (R).
            </p>
            <p className="text-base sm:text-lg text-foreground leading-relaxed">
              This managing Trust maintains the Ashram and controls other activities of the Ashram. It conducts conventions and activities on philosophical, Religious and spiritual subjects.
            </p>
          </div>
        </div>
      </section>

      {/* Call to Action */}
      <section className="py-12 sm:py-16 gradient-primary-shiny text-white text-center">
        <div className="container mx-auto px-4">
          <h3 className="text-2xl sm:text-3xl font-bold mb-6">Support Our Sacred Mission</h3>
          <p className="text-base sm:text-lg mb-8 max-w-2xl mx-auto">
            Make a generous donation to help us preserve our rich cultural heritage and continue our spiritual services.
          </p>
          <Button
