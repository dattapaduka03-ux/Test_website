                  />
                </div>
                <Button className="w-full gradient-primary text-white hover:shadow-lg shine-effect font-bold">Send</Button>
              </form>
            </Card>

            {/* Contact Information */}
            <div className="space-y-6 sm:space-y-8">
              <Card className="p-6 sm:p-8 bg-white">
                <h3 className="text-xl sm:text-2xl font-bold text-primary mb-6">Contact Information</h3>
                <div className="space-y-3 sm:space-y-4">
                  <div className="flex items-start gap-3 sm:gap-4">
                    <Mail className="w-5 sm:w-6 h-5 sm:h-6 text-primary flex-shrink-0 mt-1" />
                    <div>
                      <p className="font-semibold text-sm sm:text-base text-foreground">Email</p>
                      <a href="mailto:pranava.peetam@gmail.com" className="text-primary hover:underline">
                        pranava.peetam@gmail.com
                      </a>
                    </div>
                  </div>

                  <div className="flex items-start gap-4">
                    <Phone className="w-6 h-6 text-primary flex-shrink-0 mt-1" />
                    <div>
                      <p className="font-semibold text-foreground">Phone</p>
                      <div className="space-y-1">
                        {["+91 9535343000", "+91 9945363961", "+91 9690009393", "+91 9620000515"].map((phone) => (
                          <a key={phone} href={`tel:${phone}`} className="block text-primary hover:underline">
                            {phone}
                          </a>
                        ))}
                      </div>
                    </div>
                  </div>

                  <div className="flex items-start gap-4">
                    <MapPin className="w-6 h-6 text-primary flex-shrink-0 mt-1" />
                    <div>
                      <p className="font-semibold text-foreground">Address</p>
                      <p className="text-foreground">
                        Cross, Sir.M.V. Extension, Hosakote, Bangalore Rural District, Karnataka. Pincode - 562114, INDIA
                      </p>
                    </div>
                  </div>
                </div>
              </Card>

              {/* Social Links */}
              <Card className="p-6 sm:p-8 bg-white">
                <h3 className="text-xl sm:text-2xl font-bold text-primary mb-6">Follow Us</h3>
                <div className="flex gap-3 sm:gap-4 flex-wrap">
                  {[
                    { icon: Facebook, label: "Facebook" },
                    { icon: Youtube, label: "YouTube" },
                    { icon: Send, label: "Telegram" },
                    { icon: MessageCircle, label: "WhatsApp" },
                  ].map(({ icon: Icon, label }) => (
                    <a
                      key={label}
                      href="#"
                      className="w-12 h-12 rounded-full bg-primary text-white flex items-center justify-center hover:bg-primary/90 transition-colors"
                      title={label}
